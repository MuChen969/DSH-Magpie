{
  "name": "dsh-magpie",
  "version": "1.0.0",
  "type": "module",
  "description": "Embed the official Magpie Web GUI in DeepSeek Harness with manual install, permanent GitHub mirror config, in-DSH duplicate detection, gateway model registration and clean one-click uninstall",
  "author": "MuChen969",
  "license": "UNLICENSED",
  "homepage": "https://github.com/MuChen969/DSH-Magpie#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuChen969/DSH-Magpie.git"
  },
  "bugs": {
    "url": "https://github.com/MuChen969/DSH-Magpie/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "magpie-engine.js", "client.js", "cordis.patch.yml", "locale/*.json", "docs", "icon.svg", "README.md", "README.en.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
